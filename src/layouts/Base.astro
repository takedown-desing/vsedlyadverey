---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { CATEGORY_NAV, SITE_NAME, PHONE, EMAIL, BRANDS, DOOR_TYPES, shortName, brandName, SITE } from '../lib/data';
import { u, abs } from '../lib/url';
import { COMPANY, tel } from '../lib/company';
import RatingBadge from '../components/RatingBadge.astro';

interface Props {
  title: string;
  description?: string;
  path: string;                 // канонический путь без base, со слэшем
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  crumbs?: { url: string; name: string }[];
  image?: string | null;
  activeCat?: string;
  prev?: string;
  next?: string;
  canonicalUrl?: string;        // SEO-поле «canonical» из админки, если задано
}
const { title, description = '', path, noindex = false, schema = [], crumbs = [], image = null, activeCat = '', prev, next, canonicalUrl } = Astro.props;
const canonical = canonicalUrl && /^https?:\/\//.test(canonicalUrl) ? canonicalUrl : canonicalUrl ? abs(Astro.site, canonicalUrl) : abs(Astro.site, path);
const fullTitle = title.includes(SITE_NAME) || title.length + SITE_NAME.length + 3 > 70 ? title : `${title} | ${SITE_NAME}`;
const org = { '@type': 'Organization', '@id': abs(Astro.site, '/') + '#org', name: SITE_NAME, legalName: COMPANY.legalName, taxID: COMPANY.inn, url: abs(Astro.site, '/'), telephone: PHONE, ...(EMAIL ? { email: EMAIL } : {}), address: { '@type': 'PostalAddress', streetAddress: COMPANY.street, addressLocality: COMPANY.city, postalCode: COMPANY.postalCode, addressCountry: 'RU' } };
const graph: Record<string, unknown>[] = [org, ...schema];
if (crumbs.length > 1) graph.push({ '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(Astro.site, c.url) })) });
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const topBrands = BRANDS.filter((b) => b.tier === 'A');
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  {prev && <link rel="prev" href={abs(Astro.site, prev)} />}
  {next && <link rel="next" href={abs(Astro.site, next)} />}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={fullTitle} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={abs(Astro.site, image)} />}
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap&subset=cyrillic" rel="stylesheet" />
  <script type="application/ld+json" set:html={ld} />
</head>
<body data-base={u('/')}>
  <a class="skip" href="#main">Перейти к содержимому</a>

  <nav class="rail" id="rail" aria-label="Каталог">
    <form class="rail-search" action={u('/search/')} role="search">
      <Icon name="search" />
      <label class="sr-only" for="rail-q">Поиск по каталогу</label>
      <input id="rail-q" name="q" type="search" placeholder="Поиск" autocomplete="off" />
    </form>
    <ul>
      {CATEGORY_NAV.map((c) => (
        <li><a href={u(c.url)} class={activeCat === c.url ? 'active' : ''}><Icon name={c.icon} /><span class="rail-label">{c.name}</span></a></li>
      ))}
    </ul>
    <div class="rail-sep"></div>
    <ul>
      <li><a href={u('/brands/')}><Icon name="store" /><span class="rail-label">Бренды</span></a></li>
      <li><a href={u('/sale/')}><Icon name="percent" /><span class="rail-label">Распродажа</span></a></li>
      <li><a href={u('/blog/')}><Icon name="chat" /><span class="rail-label">Инструкции и советы</span></a></li>
    </ul>
  </nav>

  <div class="page">
    {SITE.announcement && <div class="demo-bar">{SITE.announcement}{SITE.announcementShowPhone && <> <a href={tel(PHONE)}>{PHONE}</a></>}</div>}
    <header class="top">
      <div class="wrap">
        <button class="icon-btn burger" id="burger" aria-label="Открыть каталог" aria-controls="rail" aria-expanded="false"><Icon name="menu" /></button>
        <a href={u('/')} class="logo-box" aria-label={`${SITE_NAME}, на главную`}>
          <span class="logo">ВСЁ ДЛЯ <b>ДВЕРЕЙ</b></span>
          <small class="logo-sub">{COMPANY.domain}<span class="logo-sub-x"> · дверная фурнитура</span></small>
        </a>
        <a class="phone" href={tel(PHONE)}>{PHONE}</a>
        <nav class="topnav" aria-label="Информация">
          <a href={u('/dostavka/')}>Доставка и оплата</a>
          <a href={u('/brands/')}>Бренды</a>
          <a href={u('/garantiya-i-vozvrat/')}>Гарантия и возврат</a>
          <a href={u('/showroom/')}>Шоурум</a>
          <a href={u('/kontakty/')}>Контакты</a>
        </nav>
        <div class="top-icons">
          <a class="icon-btn" href={u('/search/')} aria-label="Поиск"><Icon name="search" /></a>
          <a class="icon-btn" href={u('/cart/')} aria-label="Корзина"><Icon name="cart" /><span class="count" id="cart-count" hidden>0</span></a>
        </div>
      </div>
    </header>

    <main id="main">
      {crumbs.length > 1 && (
        <div class="wrap">
          <ol class="crumbs">
            {crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={u(c.url)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
          </ol>
        </div>
      )}
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a href={u('/')} class="logo" style="color:#fff">ВСЁ ДЛЯ <b>ДВЕРЕЙ</b></a>
            <p style="margin:14px 0 0">{SITE.footerAbout}</p>
            {SITE.showPayIcons !== false && <div class="pay" aria-label="Способы оплаты">
              <img src={u('/images/pay/mir.svg')} alt="МИР" width="72" height="20" loading="lazy" />
              <img src={u('/images/pay/mastercard.svg')} alt="Mastercard" width="44" height="44" loading="lazy" />
              <img src={u('/images/pay/visa.svg')} alt="Visa" width="52" height="44" loading="lazy" />
              <img src={u('/images/pay/sbp.svg')} alt="СБП" width="64" height="32" loading="lazy" />
            </div>}
            <div style="margin-top:16px"><RatingBadge dark /></div>
          </div>
          <div>
            <h4>Контактная информация</h4>
            <ul class="foot-contact">
              <li><a class="foot-big" href={tel(COMPANY.phoneMain)}>{COMPANY.phoneMain}</a><small>{COMPANY.phoneMainNote}</small></li>
              {COMPANY.email && <li><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a><small>заказы и вопросы</small></li>}
              <li><a href={u('/kontakty/')}>{COMPANY.address}</a><small>шоурум, {COMPANY.metro}</small></li>
            </ul>
          </div>
          <div>
            <h4>Шоурум</h4>
            <p style="margin:0">Образцы {COMPANY.showroomBrands.map(brandName).join(' и ')} можно посмотреть вживую.</p>
            {COMPANY.hours.length > 0
              ? <div class="hours" style="margin-top:10px">{COMPANY.hours.map((h) => <><span>{h.d}</span><span>{h.t}</span></>)}</div>
              : <p style="margin:10px 0 0"><small>Время визита согласуйте по телефону</small></p>}
            <h4 style="margin-top:22px">Мессенджеры</h4>
            <div class="socials" aria-label="Мессенджеры">{COMPANY.messengers.map((m) => m.url ? <a href={m.url} rel="noopener">{m.name}</a> : <span title="Аккаунт подключается">{m.name}</span>)}</div>
          </div>
          <div>
            <h4>Каталог</h4>
            <ul>{CATEGORY_NAV.slice(0, 9).map((c) => <li><a href={u(c.url)}>{c.name}</a></li>)}<li><a href={u('/brands/')}>Все бренды</a></li><li><a href={u('/sale/')}>Распродажа</a></li></ul>
          </div>
          <div>
            <h4>Покупателям</h4>
            <ul>
              <li><a href={u('/dostavka/')}>Доставка</a></li>
              <li><a href={u('/oplata/')}>Оплата</a></li>
              <li><a href={u('/garantiya-i-vozvrat/')}>Гарантия и возврат</a></li>
              <li><a href={u('/showroom/')}>Шоурум</a></li>
              <li><a href={u('/blog/')}>Инструкции и советы</a></li>
              <li><a href={u('/faq/')}>Вопросы и ответы</a></li>
              <li><a href={u('/o-kompanii/')}>О компании</a></li>
              <li><a href={u('/kontakty/')}>Контакты</a></li>
              <li><a href={u('/sitemap/')}>Карта сайта</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {new Date().getFullYear()} {COMPANY.legalName}, ИНН {COMPANY.inn}, ОГРН {COMPANY.ogrn}. {SITE.footerLegalNote}</span>
          <span><a href={u('/politika-konfidencialnosti/')}>Политика конфиденциальности</a> · <a href={u('/publichnaya-oferta/')}>Оферта</a></span>
        </div>
      </div>
    </footer>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    // --- мобильная панель
    const rail = document.getElementById('rail'); const burger = document.getElementById('burger');
    burger?.addEventListener('click', (e) => { e.stopPropagation(); const o = rail!.classList.toggle('open'); burger.setAttribute('aria-expanded', String(o)); });
    document.addEventListener('click', (e) => { if (rail?.classList.contains('open') && !rail.contains(e.target as Node)) rail.classList.remove('open'); });
    // --- корзина (демо, localStorage)
    type Item = { slug: string; name: string; finish: string; price: number | null; img: string; qty: number; url: string };
    const KEY = 'maniglia-cart';
    const read = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const write = (a: Item[]) => { try { localStorage.setItem(KEY, JSON.stringify(a)); } catch {} renderCount(); };
    const renderCount = () => { const n = read().reduce((s, i) => s + i.qty, 0); const el = document.getElementById('cart-count'); if (el) { el.textContent = String(n); el.hidden = n === 0; } };
    (window as any).maniglia = { read, write };
    renderCount();
    const toast = (t: string) => { const el = document.getElementById('toast')!; el.textContent = t; el.classList.add('on'); setTimeout(() => el.classList.remove('on'), 2200); };
    // +/- количества в карточках листинга
    document.addEventListener('click', (e) => {
      const q = (e.target as HTMLElement).closest('[data-cq]') as HTMLElement | null;
      if (!q) return;
      const inp = q.parentElement?.querySelector('input') as HTMLInputElement;
      inp.value = String(Math.max(1, (parseInt(inp.value, 10) || 1) + +(q.dataset.cq || 0)));
    });
    // добавить весь комплект
    document.addEventListener('click', (e) => {
      const kb = (e.target as HTMLElement).closest('[data-add-kit]') as HTMLElement | null;
      if (!kb) return;
      const items = read();
      for (const it of JSON.parse(kb.dataset.items || '[]') as Item[]) {
        const ex = items.find((i) => i.slug === it.slug && i.finish === it.finish);
        if (ex) ex.qty += it.qty; else items.push(it);
      }
      write(items); toast('Комплект добавлен в корзину');
    });
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-add]') as HTMLElement | null;
      if (!b) return;
      e.preventDefault();
      const d = b.dataset;
      const qtyEl = (b.closest('[data-card]')?.querySelector('[data-cqty]') || document.getElementById('qty')) as HTMLInputElement | null;
      const qty = Math.max(1, parseInt(qtyEl?.value || '1', 10) || 1);
      const items = read(); const key = d.slug + '|' + d.finish;
      const ex = items.find((i) => i.slug + '|' + i.finish === key);
      if (ex) ex.qty += qty; else items.push({ slug: d.slug!, name: d.name!, finish: d.finish || '', price: d.price ? +d.price : null, img: d.img || '', qty, url: d.url || '' });
      write(items); toast('Добавлено в корзину');
    });
  </script>
</body>
</html>
