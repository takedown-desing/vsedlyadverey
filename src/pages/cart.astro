---
import Base from '../layouts/Base.astro';
import { SITE_NAME, SITE } from '../lib/data';
import { u } from '../lib/url';
---
<Base title={`Корзина | ${SITE_NAME}`} path="/cart/" noindex crumbs={[{ url: '/', name: 'Главная' }, { url: '/cart/', name: 'Корзина' }]}>
  <div class="wrap">
    <div class="page-head"><h1>Корзина</h1></div>
    <div id="cart"></div>
  </div>
  <script define:vars={{ base: u('/'), cartNote: SITE.cartNote || '' }}>
    const box = document.getElementById('cart');
    const fmt = (n) => new Intl.NumberFormat('ru-RU').format(n) + ' ₽';
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const render = () => {
      const m = window.shopCart; const items = m.read();
      if (!items.length) { box.innerHTML = `<div class="empty">Корзина пуста. <a href="${base}catalog/">Перейти в каталог</a></div>`; return; }
      const total = items.reduce((s, i) => s + (i.price || 0) * i.qty, 0);
      box.innerHTML = `<table class="cart-table"><thead><tr><th></th><th>Товар</th><th>Кол-во</th><th>Сумма</th><th></th></tr></thead><tbody>${items.map((i, k) => `<tr><td>${i.img ? `<img src="${base}${i.img.replace(/^\//, '')}" alt="">` : ''}</td><td><a href="${base}${i.url.replace(/^\//, '')}">${esc(i.name)}</a><br><small>${esc(i.finish)}</small></td><td><input type="number" min="1" value="${i.qty}" data-k="${k}" style="width:64px;height:36px;padding:0 8px" aria-label="Количество"></td><td>${i.price ? fmt(i.price * i.qty) : 'по запросу'}</td><td><button class="btn btn-ghost btn-sm" data-del="${k}">Удалить</button></td></tr>`).join('')}</tbody></table>
      <p style="font-size:22px;margin:22px 0">Итого: ${fmt(total)}</p>
      <form class="form" id="order"><input name="name" placeholder="Имя" required aria-label="Имя"><input name="phone" type="tel" placeholder="Телефон" required aria-label="Телефон"><textarea name="addr" placeholder="Город и адрес доставки" aria-label="Адрес"></textarea><button class="btn btn-accent">Оформить заказ</button><p style="font-size:13px;color:var(--c-muted)">${esc(cartNote)}</p></form>`;
      box.querySelectorAll('[data-k]').forEach((el) => el.addEventListener('change', () => { const a = m.read(); a[+el.dataset.k].qty = Math.max(1, +el.value || 1); m.write(a); render(); }));
      box.querySelectorAll('[data-del]').forEach((el) => el.addEventListener('click', () => { const a = m.read(); a.splice(+el.dataset.del, 1); m.write(a); render(); }));
      document.getElementById('order').addEventListener('submit', (e) => { e.preventDefault(); m.write([]); box.innerHTML = '<div class="empty">Сайт в тестовом режиме: заказ не отправлен. Чтобы оформить покупку, позвоните нам по телефону из шапки сайта.</div>'; });
    };
    document.addEventListener('DOMContentLoaded', render);
  </script>
</Base>
