---
// Корневые страницы: хабы «по типу двери», служебные и B2B.
import Base from '../../layouts/Base.astro';
import SectionPage from '../../components/SectionPage.astro';
import Prose from '../../components/Prose.astro';
import Listing from '../../components/Listing.astro';
import { registry, services, products, SITE_NAME, PHONE, isEmptyPage } from '../../lib/data';
import { COMPANY } from '../../lib/company';
import { u } from '../../lib/url';
export function getStaticPaths() {
  const ROOT_TYPES = ['door-type', 'utility', 'b2b'];
  const SKIP = ['/search/', '/cart/', '/compare/', '/account/', '/sitemap/', '/new/', '/product/{slug}/', '/blog/', '/brands/', '/', '/kontakty/', '/o-kompanii/', '/otzyvy/'];
  return registry.filter((p) => ROOT_TYPES.includes(p.type) && !SKIP.includes(p.url) && /^\/[^/]+\/$/.test(p.url) && !isEmptyPage(p.url))
    .map((p) => ({ params: { slug: p.url.replace(/\//g, '') }, props: { url: p.url, type: p.type, h1: p.h1 } }));
}
const { url, type, h1 } = Astro.props;
const s = services.get(url);
const legal = url === '/politika-konfidencialnosti/' || url === '/publichnaya-oferta/';
const sale = url === '/sale/' ? products.filter((p) => p.variants.length >= 3).slice(0, 24) : [];
const crumbs = [{ url: '/', name: 'Главная' }, { url, name: s?.h1 || h1 }];
const fallback = legal
  ? `Документ готовится. Оператор персональных данных и продавец: ${COMPANY.legalName}, ИНН ${COMPANY.inn}, ОГРН ${COMPANY.ogrn}, ${COMPANY.legalAddress}.\n\nПо вопросам обработки персональных данных и условий продажи: ${PHONE}.`
  : url === '/sale/' ? 'Подборка моделей с выбором покрытий. Сайт работает в тестовом режиме, скидки пока не рассчитываются: актуальные акции уточняйте у менеджера.'
  : `Раздел в подготовке. Телефон: ${PHONE}.`;
---
{type === 'door-type' ? <SectionPage url={url} /> : (
  <Base title={s?.title || `${h1} | ${SITE_NAME}`} description={s?.description || h1} path={url} crumbs={crumbs} noindex={legal}>
    <div class="wrap">
      <div class="page-head"><h1>{s?.h1 || h1}</h1></div>
      <section class="section" style="padding-top:0"><Prose md={s?.body || fallback} /></section>
      {sale.length > 0 && <Listing items={sale} />}
      {type === 'b2b' && (
        <section class="section">
          <h2>Оставить заявку</h2>
          <form class="form" data-demo-form>
            <label class="sr-only" for="n">Имя</label><input id="n" name="name" placeholder="Имя" required />
            <label class="sr-only" for="ph">Телефон</label><input id="ph" name="phone" placeholder="Телефон" type="tel" required />
            <label class="sr-only" for="m">Сообщение</label><textarea id="m" name="msg" placeholder="Что нужно подобрать?"></textarea>
            <button class="btn btn-accent" type="submit">Отправить</button>
            <p style="font-size:13px;color:var(--c-muted)">Тестовый режим: форма пока не отправляет данные.</p>
          </form>
        </section>
      )}
    </div>
  </Base>
)}
<script>
  document.querySelectorAll<HTMLFormElement>('[data-demo-form]').forEach((f) => f.addEventListener('submit', (e) => { e.preventDefault(); f.innerHTML = '<p>Спасибо! В рабочей версии заявка уйдёт менеджеру.</p>'; }));
</script>
