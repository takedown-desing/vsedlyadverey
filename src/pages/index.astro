---
import Base from '../layouts/Base.astro';
import Tiles from '../components/Tiles.astro';
import ProductCard from '../components/ProductCard.astro';
import BrandTiles from '../components/BrandTiles.astro';
import Prose from '../components/Prose.astro';
import Blocks from '../components/Blocks.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import RatingBadge from '../components/RatingBadge.astro';
import { REVIEWS, REVIEWS_NOTE } from '../lib/reviews';
import { COMPANY, tel, mapSrc } from '../lib/company';
import {
  CATEGORY_NAV, products, pageTexts, articles, productsFor, firstImage, colorImage, DOOR_TYPES, shortName, SITE_NAME, BRANDS,
  registry, seriesTexts, brandName, COLOR_HEX, HOME,
} from '../lib/data';
import type { Product } from '../lib/data';
import { u, abs } from '../lib/url';

const t = (pageTexts.get('/') || {}) as any;
// плитки разделов с фото: самый характерный товар раздела (без логотипов дистрибьюторов, если есть)
const tileImg = (url: string) => { const ps = productsFor(url).filter((p) => firstImage(p)); return firstImage(ps.find((p) => p.variants.some((v) => v.imageSrc && !/made-italy|fratelli-cattini\.com/.test(v.imageSrc))) || ps[0]); };
const tiles = CATEGORY_NAV.filter((c) => productsFor(c.url).length).map((c) => ({ url: c.url, name: c.name, icon: c.icon, img: tileImg(c.url), count: productsFor(c.url).length }));
const hasImg = (p: Product) => !!firstImage(p);
const pickIn = (cat: string, n: number) => products.filter((p) => p.category.startsWith(cat) && hasImg(p)).slice(0, n);
// hero: фото без логотипов дистрибьюторов
const clean = (p: Product) => p.variants.some((v) => v.image && v.imageSrc && !/made-italy|fratelli-cattini\.com/.test(v.imageSrc));
const heroImg = (cat: string) => firstImage(products.find((p) => p.category.startsWith(cat) && clean(p)) || products[0]);
const srBrands = COMPANY.showroomBrands.map(brandName).join(' и ');
// слайды редактируются в админке («Главная страница»); картинка либо загружена, либо берётся из раздела imageFrom
const showroomImg = () => firstImage(products.find((p) => COMPANY.showroomBrands.includes(p.brand) && p.category.startsWith('/catalog/dvernye-ruchki/') && clean(p)) || products[0]);
const slides = ((HOME.slides || []) as any[]).filter((s) => s && s.title).map((s) => ({
  kicker: s.kicker || '', h: s.title, p: s.text || '', cta: s.cta || '/catalog/', ctaText: s.ctaText || 'Подробнее',
  img: s.image || (s.imageFrom === 'showroom' ? showroomImg() : heroImg(s.imageFrom || '/catalog/dvernye-ruchki/')),
}));

// витрина с вкладками по категориям (как «полки» у morelli.ru)
const shelves = [
  { id: 'hits', name: 'Хиты', items: [...pickIn('/catalog/dvernye-ruchki/', 3), ...pickIn('/catalog/dvernye-petli/skrytye/', 2), ...pickIn('/catalog/mezhkomnatnye-zamki/magnitnye/', 2), ...pickIn('/catalog/upory-i-ogranichiteli/', 1)] },
  { id: 'ruchki', name: 'Ручки', items: pickIn('/catalog/dvernye-ruchki/', 8) },
  { id: 'zamki', name: 'Замки', items: pickIn('/catalog/mezhkomnatnye-zamki/', 8) },
  { id: 'petli', name: 'Петли', items: pickIn('/catalog/dvernye-petli/', 8) },
  { id: 'razdv', name: 'Раздвижные системы', items: pickIn('/catalog/razdvizhnye-sistemy/', 8) },
  { id: 'upory', name: 'Упоры и доводчики', items: [...pickIn('/catalog/upory-i-ogranichiteli/', 4), ...pickIn('/catalog/dovodchiki/', 4)] },
].filter((s) => s.items.length);

// «Фурнитура для вашей двери» (как «Комплектующие для» у doorlock.ru)
const doorCards = DOOR_TYPES.slice(0, 8).map((d) => {
  const ps = productsFor(d.url).filter(hasImg);
  return { url: d.url, name: d.h1.replace(/^Фурнитура для /, '').replace(/^Противопожарная фурнитура.*/, 'Противопожарных дверей').replace(/^./, (c) => c.toUpperCase()), img: ps.length ? firstImage(ps[Math.min(1, ps.length - 1)]) : null, n: productsFor(d.url).length };
});

// подбор по цвету: картинка товара именно в этом покрытии
const COLORS = [['chernye', 'black', 'Чёрный'], ['zoloto', 'gold', 'Золото'], ['hrom', 'chrome', 'Хром'], ['bronza', 'bronze', 'Бронза'], ['nikel', 'nickel', 'Никель'], ['latun', 'brass', 'Латунь'], ['belye', 'white', 'Белый'], ['grafit', 'graphite', 'Графит']]
  .map(([slug, col, name]) => {
    const url = `/catalog/dvernye-ruchki/${slug}/`;
    const ps = productsFor(url);
    return { url, col, name, n: ps.length, img: ps.map((p) => colorImage(p, col)).find(Boolean) ?? null };
  }).filter((c) => registry.some((r) => r.url === c.url) && c.n > 0);

// популярные серии
const series = registry.filter((r) => r.type === 'series').map((r) => {
  const ps = productsFor(r.url).filter(hasImg); const s = seriesTexts.get(r.url.split('/')[2]);
  return { url: r.url, name: s?.name || r.h1, brand: ps[0] ? brandName(ps[0].brand) : '', img: ps[0] ? firstImage(ps[0]) : null, n: productsFor(r.url).length };
}).filter((s) => s.img).slice(0, 6);

// комплект на дверь: по одному товару каждого типа в одном цвете (чёрный)
const kitColor = 'black';
const kitParts = [
  ['/catalog/dvernye-ruchki/', 'Ручка'], ['/catalog/zavertki-i-nakladki/', 'Завертка'], ['/catalog/mezhkomnatnye-zamki/', 'Замок'],
  ['/catalog/dvernye-petli/', 'Петли'], ['/catalog/upory-i-ogranichiteli/', 'Упор'],
].map(([cat, label]) => {
  const p = products.find((x) => x.category.startsWith(cat) && x.variants.some((v) => v.color === kitColor && v.image));
  return p ? { label, p, img: colorImage(p, kitColor) } : null;
}).filter(Boolean) as { label: string; p: Product; img: string }[];

const D = COMPANY.delivery; const fmt = (n: number) => new Intl.NumberFormat('ru-RU').format(n);
const services = ((HOME.services || []) as any[]).filter((s) => s && s.title).map((s) => ({ icon: s.icon || 'check', t: s.title, d: s.text || '' }));
const promo = ((HOME.promo || []) as any[]).filter((s) => s && s.title);
const lead = HOME.lead || {}; const aside = HOME.aside || {}; const sr = HOME.showroom || {};
const schema = [{ '@type': 'WebSite', name: SITE_NAME, url: abs(Astro.site, '/'), potentialAction: { '@type': 'SearchAction', target: abs(Astro.site, '/search/') + '?q={q}', 'query-input': 'required name=q' } }];
---
<Base title={t.title || `${SITE_NAME}: интернет-магазин дверной фурнитуры`} description={t.description || 'Интернет-магазин дверной фурнитуры: ручки, замки, петли, доводчики европейских брендов. Шоурум в Москве, доставка по России.'} path="/" schema={schema}>
  <section class="hero" aria-label="Предложения">
    {slides.map((s, i) => (
      <div class={'hero-slide' + (i === 0 ? ' on' : '')} data-slide>
        <div class="hero-copy">
          <div class="kicker">{s.kicker}</div>
          {i === 0 ? <h1 style="font-size:clamp(30px,3.6vw,50px);font-weight:300">{t.h1 || s.h}</h1> : <h2>{s.h}</h2>}
          <p>{s.p}</p>
          <div><a class="btn" href={u(s.cta)}>{s.ctaText}</a></div>
        </div>
        <div class="hero-art">{s.img && <img src={u(s.img)} alt="" width="380" height="380" loading={i === 0 ? 'eager' : 'lazy'} />}</div>
      </div>
    ))}
    <div class="hero-dots">{slides.map((_, i) => <button type="button" class={i === 0 ? 'on' : ''} aria-label={`Слайд ${i + 1}`} data-dot={i}></button>)}</div>
  </section>

  {promo.length > 0 && <div class="promo">
    {promo.map((p) => <a href={u(p.url || '/catalog/')}><Icon name={p.icon || 'kit'} /><span><span class="big">{p.title}</span><br /><span class="sm">{p.text}</span></span></a>)}
  </div>}

  <h2 class="center-title">Дверная фурнитура</h2>
  <div class="wrap">
    <section class="section"><Tiles items={tiles} /></section>

    <!-- 1. Витрина с вкладками -->
    {shelves.length > 0 && (
      <section class="section" style="padding-top:0" data-tabs>
        <div class="section-title"><h2>Популярные товары</h2><a href={u('/catalog/')}>Весь каталог</a></div>
        <div class="tabs-row" role="tablist">{shelves.map((s, i) => <button type="button" role="tab" class={'tab' + (i === 0 ? ' on' : '')} aria-selected={i === 0 ? 'true' : 'false'} data-tab={s.id}>{s.name}</button>)}</div>
        {shelves.map((s, i) => <div class="grid" role="tabpanel" data-panel={s.id} hidden={i !== 0}>{s.items.map((p, k) => <ProductCard p={p} eager={i === 0 && k < 4} />)}</div>)}
      </section>
    )}

    <!-- 2. Фурнитура для вашей двери -->
    <section class="section">
      <div class="section-title"><h2>Фурнитура для вашей двери</h2></div>
      <div class="door-cards">
        {doorCards.map((d) => <a class="door-card" href={u(d.url)}><span class="dc-name">{d.name}</span>{d.n > 0 && <span class="dc-n">{d.n} товаров</span>}{d.img ? <img src={u(d.img)} alt="" width="120" height="120" loading="lazy" /> : <Icon name="kit" size={60} />}</a>)}
      </div>
    </section>

    <!-- 3. Подбор по цвету -->
    {COLORS.length > 0 && (
      <section class="section">
        <div class="section-title"><h2>Дверные ручки по цвету</h2><a href={u('/catalog/dvernye-ruchki/')}>Все ручки</a></div>
        <div class="color-cards">
          {COLORS.map((c) => <a class="color-card" href={u(c.url)}><span class="cc-img">{c.img && <img src={u(c.img)} alt="" width="120" height="120" loading="lazy" />}</span><span class="cc-name"><span class="sw" style={`background:${COLOR_HEX[c.col]}`}></span>{c.name}</span><span class="cc-n">{c.n} моделей</span></a>)}
        </div>
      </section>
    )}

    <!-- 4. Собрать комплект -->
    {kitParts.length >= 3 && (
      <section class="section">
        <div class="kit-banner">
          <div class="kit-copy">
            <div class="kicker">Сервис подбора</div>
            <h2>Соберите комплект на дверь в одном покрытии</h2>
            <ol class="kit-steps"><li>Выберите ручку и покрытие</li><li>Добавьте завертку или накладку</li><li>Подберите замок и петли под вес полотна</li><li>Закончите упором</li></ol>
            <a class="btn btn-accent" href={u('/catalog/komplekty-furnitury/')}>Собрать комплект</a>
          </div>
          <div class="kit-items">
            {kitParts.map((k) => <a class="kit-item" href={u(`/product/${k.p.slug}/`)}><img src={u(k.img)} alt={k.p.name} width="130" height="130" loading="lazy" /><span>{k.label}</span></a>)}
          </div>
        </div>
      </section>
    )}

    <!-- 5. Популярные коллекции -->
    {series.length > 0 && (
      <section class="section">
        <div class="section-title"><h2>Популярные коллекции</h2><a href={u('/brands/')}>Все бренды</a></div>
        <div class="series-cards">
          {series.map((s) => <a class="series-card" href={u(s.url)}><img src={u(s.img!)} alt="" width="160" height="160" loading="lazy" /><span class="sc-brand">{s.brand}</span><span class="sc-name">{s.name}</span><span class="sc-n">{s.n} моделей</span></a>)}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section-title"><h2>Бренды</h2><a href={u('/brands/')}>Все бренды</a></div>
      <BrandTiles slugs={BRANDS.filter((b) => b.tier !== 'C').map((b) => b.slug)} />
    </section>

    <!-- 6. Почему мы (сервисные плитки, как у doorlock.ru) -->
    <section class="section">
      <div class="section-title"><h2>Почему покупают у нас</h2><a href={u('/o-kompanii/')}>О компании</a></div>
      <div class="svc-grid">{services.map((s) => <div class="svc"><Icon name={s.icon} size={34} /><b>{s.t}</b><span>{s.d}</span></div>)}</div>
    </section>

    <!-- 7. Шоурум с картой -->
    <section class="section">
      <div class="showroom">
        <div class="sr-copy">
          <div class="kicker">{sr.kicker || 'Шоурум в Москве'}</div>
          <h2>{sr.title || `Приезжайте посмотреть образцы ${srBrands}`}</h2>
          <p>{COMPANY.address}. {COMPANY.metro}.</p>
          {COMPANY.hours.length > 0
            ? <div class="hours" style="margin:12px 0 18px">{COMPANY.hours.map((h) => <><span>{h.d}</span><span>{h.t}</span></>)}</div>
            : <p style="margin:12px 0 18px;color:var(--c-text-2)">{sr.noHoursText || 'Время визита согласуйте по телефону.'}</p>}
          <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn" href={u('/kontakty/')}>Как добраться</a><a class="btn btn-ghost" href={tel(COMPANY.phoneMain)}>{COMPANY.phoneMain}</a></div>
        </div>
        <iframe class="map" src={mapSrc(15)} title="Шоурум на карте" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>

    <section class="section">
      <div class="section-title"><h2>Отзывы покупателей</h2><a href={u('/otzyvy/')}>Все отзывы</a></div>
      <div style="display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-bottom:18px"><RatingBadge /><span class="rb-note">{REVIEWS_NOTE}</span></div>
      <div class="reviews-grid">{REVIEWS.slice(0, 3).map((r) => <ReviewCard r={r} />)}</div>
    </section>

    <!-- 9. Каталог/прайс в мессенджер (как у morelli.ru) -->
    <section class="section">
      <div class="lead-banner">
        <div><h2>{lead.title || 'Поможем подобрать фурнитуру'}</h2><p>{lead.text}</p></div>
        <form class="lead-form" data-demo-form><label class="sr-only" for="lf">Телефон</label><input id="lf" name="contact" type="tel" placeholder="Телефон" required /><button class="btn btn-accent" type="submit">{lead.button || 'Перезвоните мне'}</button></form>
      </div>
    </section>

    {articles.length > 0 && (
      <section class="section">
        <div class="section-title"><h2>Инструкции и советы</h2><a href={u('/blog/')}>Все статьи</a></div>
        <div class="post-grid">{articles.slice(0, 3).map((a) => <a class="post-card" href={u(`/blog/${a.slug}/`)}><span class="h">{a.h1}</span><span class="d">{a.description}</span><span class="m">{a.readingMinutes || 6} мин чтения</span></a>)}</div>
      </section>
    )}

    <section class="section two-col">
      <div>{t.blocks?.length ? <Blocks blocks={t.blocks} /> : <Prose md={t.text} />}<Faq items={t.faq} /></div>
      <aside class="aside-box">
        <h3>{aside.title || 'Цены и наличие'}</h3>
        <p style="font-size:14.5px;color:var(--c-text-2)">{aside.text}</p>
        {aside.button && <a class="btn btn-sm" href={u(aside.url || '/oplata/')}>{aside.button}</a>}
      </aside>
    </section>
  </div>
  <script>
    const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')]; const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let i = 0; const show = (n: number) => { i = (n + slides.length) % slides.length; slides.forEach((s, k) => s.classList.toggle('on', k === i)); dots.forEach((d, k) => d.classList.toggle('on', k === i)); };
    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => show(i + 1), 6000);
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
        root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); });
        root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== b.dataset.tab; });
      }));
    });
    document.querySelectorAll<HTMLFormElement>('[data-demo-form]').forEach((f) => f.addEventListener('submit', (e) => { e.preventDefault(); f.innerHTML = '<p>Спасибо! Сайт в тестовом режиме: заявка пока не отправляется, позвоните нам по телефону.</p>'; }));
  </script>
</Base>
