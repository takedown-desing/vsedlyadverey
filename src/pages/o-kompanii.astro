---
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import BrandTiles from '../components/BrandTiles.astro';
import { COMPANY, tel } from '../lib/company';
import { SITE_NAME, products, BRANDS, brandName } from '../lib/data';
const srBrands = COMPANY.showroomBrands.map(brandName).join(' и ');
import { u, abs } from '../lib/url';
const models = products.length;
const variants = products.reduce((s, p) => s + p.variants.length, 0);
const blocks = [
  { type: 'stats', items: [
    { value: String(BRANDS.length), label: 'брендов в каталоге' },
    { value: String(models), label: 'моделей на сайте' },
    { value: String(variants), label: 'вариантов покрытий' },
    { value: String(COMPANY.showroomBrands.length), label: 'бренда в шоуруме' },
  ] },
  { type: 'text', title: 'Кто мы', md: `«${SITE_NAME}» (${COMPANY.legalName}) продаёт европейскую дверную фурнитуру для межкомнатных, входных, раздвижных и стеклянных дверей. Начинаем с итальянской фабрики Colombo Design и португальской TUPAI: их образцы стоят в нашем шоуруме в Москве. Остальные бренды каталога, от скрытых петель Krona Koblenz до магнитных замков AGB, привозим со склада поставщика.\\n\\nНаша задача простая: чтобы ручка, замок, петли и упор подошли к двери и друг к другу по размерам, покрытию и стилю. Поэтому каталог устроен по типу изделия и по типу двери, а в карточках указаны размеры, совместимость и что нужно докупить.` },
  { type: 'cards', title: 'Как мы работаем', items: [
    { icon: 'kit', title: 'Подбор комплекта', text: 'Собираем ручку, завертку, замок, петли и упор в одном покрытии под вашу дверь и толщину полотна.' },
    { icon: 'store', title: 'Шоурум в Москве', text: `На Флотской, 5 к2 можно посмотреть и подержать в руках образцы ${srBrands}.` },
    { icon: 'truck', title: 'Доставка по России', text: 'По Москве и ближайшему Подмосковью возим своим транспортом, в регионы отправляем транспортными компаниями.' },
    { icon: 'shield', title: 'Гарантия производителя', text: 'Продаём оригинальную продукцию, гарантия действует по условиям бренда.' },
  ] },
  { type: 'table', title: 'Цены и наличие', head: ['Вопрос', 'Как у нас'], rows: [
    ['Цены', 'Рекомендованные розничные цены производителей. Фурнитура европейская, поэтому цена зависит от курса евро'],
    ['Наличие', 'Работаем со склада поставщика. Если модели на складе нет, привозим под заказ от производителя'],
    ['Предоплата', `При заказе от производителя ${COMPANY.prepayOnOrder}% стоимости товара`],
    ['Оплата', 'Наличными курьеру или по счёту, подробнее на странице [оплаты](/oplata/)'],
  ] },
  { type: 'steps', title: 'Как проходит заказ', items: [
    { title: 'Выбор', text: 'Выберите товары в [каталоге](/catalog/) или пришлите менеджеру фото и размеры двери.' },
    { title: 'Подтверждение', text: 'Менеджер проверит наличие, совместимость и согласует сроки.' },
    { title: 'Оплата', text: 'Наличными курьеру или по счёту для физических и юридических лиц.' },
    { title: 'Получение', text: 'Доставка по Москве до подъезда или транспортной компанией по России.' },
  ] },
];
---
<Base title={`О магазине «${SITE_NAME}»: дверная фурнитура в Москве`} description={`«${SITE_NAME}»: европейская дверная фурнитура, шоурум в Москве с образцами ${srBrands}, подбор комплектов под дверь, доставка по России.`} path="/o-kompanii/" crumbs={[{ url: '/', name: 'Главная' }, { url: '/o-kompanii/', name: 'О компании' }]}
  schema={[{ '@type': 'AboutPage', name: `О магазине «${SITE_NAME}»`, url: abs(Astro.site, '/o-kompanii/') }]}>
  <div class="wrap">
    <div class="page-head"><h1>О компании</h1><p class="lead">Магазин дверной фурнитуры с шоурумом в Москве. Помогаем собрать фурнитуру так, чтобы всё подошло с первого раза.</p></div>
    <Blocks blocks={blocks} />
    <section class="section"><h2>Бренды, с которыми мы работаем</h2><BrandTiles small /></section>
    <section class="section two-col">
      <div class="aside-box">
        <h3>Контакты</h3>
        <p style="margin:0 0 6px"><a href={tel(COMPANY.phoneMain)} style="font-size:20px">{COMPANY.phoneMain}</a></p>
        <p style="margin:0 0 6px">{COMPANY.address}</p>
        <p style="margin:0 0 14px">{COMPANY.hours.length ? COMPANY.hours.map((h) => `${h.d} ${h.t}`).join(' · ') : COMPANY.metro}</p>
        <a class="btn btn-sm" href={u('/kontakty/')}>Схема проезда и реквизиты</a>
      </div>
      <div></div>
    </section>
  </div>
</Base>
