---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Blocks from '../../components/Blocks.astro';
import Faq from '../../components/Faq.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { REVIEWS, REVIEWS_NOTE } from '../../lib/reviews';
import Icon from '../../components/Icon.astro';
import {
  products, regByUrl, breadcrumbs, brandName, rub, COLOR_HEX, COLOR_NAMES, CATEGORY_NAV, articles, SERIES_RULES, registry, SITE_NAME, minPrice,
  productTexts, colorSlug, STOCK_LABEL, inShowroom, SITE, NO_PHOTO,
} from '../../lib/data';
import { COMPANY } from '../../lib/company';
import type { Product } from '../../lib/data';
import { u, abs } from '../../lib/url';
export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const url = `/product/${p.slug}/`;
const catReg = regByUrl.get(p.category);
const crumbs = [...(catReg ? breadcrumbs(p.category) : [{ url: '/', name: 'Главная' }]), { url, name: p.name }];
const v0 = p.variants.find((v) => v.image) || p.variants[0];
const bname = brandName(p.brand);
const price = minPrice(p);
// покрытие «стандарт» (товар загружен без покрытий) не пишем в Title и не показываем выбором из одного пункта
const realFinish = (f?: string) => !!f && !/^стандарт$/i.test(f);
const withFinish = `${p.name}${realFinish(v0.finish) ? ', ' + v0.finish : ''}`;
const h1 = (p as any).h1 || p.name;
const title = withFinish.length <= 55 ? `${withFinish}: купить, цена` : p.name.length <= 60 ? `${p.name}: купить` : p.name;
const description = `${p.name} (${bname}${p.article ? ', арт. ' + p.article : ''}). ${p.variants.length > 1 ? p.variants.length + ' покрытий. ' : ''}${price ? 'Цена от ' + new Intl.NumberFormat('ru-RU').format(price) + ' ₽. ' : ''}Доставка по Москве и России.`;
const topCat = CATEGORY_NAV.find((c) => p.category.startsWith(c.url))?.url || '';
// у товара без раздела «похожих» нет (иначе туда попадут случайные товары без раздела)
const similar = p.category.startsWith('/catalog/') && p.category !== '/catalog/' ? products.filter((x) => x.slug !== p.slug && x.category === p.category).slice(0, 4) : [];
const sameSeries = p.series ? products.filter((x) => x.slug !== p.slug && x.brand === p.brand && x.series === p.series).slice(0, 4) : [];
const compatCats: Record<string, string[]> = {
  'dvernye-ruchki': ['/catalog/zavertki-i-nakladki/', '/catalog/mezhkomnatnye-zamki/', '/catalog/dvernye-petli/skrytye/'],
  'mezhkomnatnye-zamki': ['/catalog/dvernye-ruchki/', '/catalog/dvernye-petli/'],
  'dvernye-petli': ['/catalog/mezhkomnatnye-zamki/magnitnye/', '/catalog/dvernye-ruchki/'],
  'zavertki-i-nakladki': ['/catalog/dvernye-ruchki/', '/catalog/mezhkomnatnye-zamki/s-fiksatorom/'],
};
const catSlug = p.category.split('/')[2];
const withImg = (x: Product) => x.variants.some((v) => v.image);
const compat = (compatCats[catSlug] || []).flatMap((c) => products.filter((x) => withImg(x) && x.category.startsWith(c) && (x.brand === p.brand || x.variants.some((v) => v.color === v0.color))).slice(0, 2)).slice(0, 4);
const seriesUrl = registry.find((r) => r.type === 'series' && SERIES_RULES[r.url.split('/')[2]]?.brand === p.brand && SERIES_RULES[r.url.split('/')[2]].re.test((p.series || '') + ' ' + p.name))?.url;
const guide = articles.find((a) => (a.related || []).some((r) => p.category.startsWith(r)));
const offers = p.variants.filter((v) => v.price).map((v) => ({ '@type': 'Offer', price: v.price, priceCurrency: 'RUB', availability: v.inStock === false ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock', url: abs(Astro.site, url), sku: v.article || p.article, itemCondition: 'https://schema.org/NewCondition' }));
const schema: any[] = [{
  '@type': 'Product', name: p.name, sku: p.article, mpn: p.article, brand: { '@type': 'Brand', name: bname }, description: p.description,
  image: p.variants.filter((v) => v.image).map((v) => abs(Astro.site, v.image!)), color: v0.finish, material: p.material || undefined, url: abs(Astro.site, url),
  ...(offers.length ? { offers: offers.length === 1 ? offers[0] : { '@type': 'AggregateOffer', priceCurrency: 'RUB', lowPrice: Math.min(...offers.map((o) => o.price as number)), highPrice: Math.max(...offers.map((o) => o.price as number)), offerCount: offers.length } } : {}),
}];
const pt = productTexts.get(p.slug);
const myReviews = REVIEWS.filter((r) => r.product === p.slug);
if (pt?.faq?.length) schema.push({ '@type': 'FAQPage', mainEntity: pt.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } as any);
const specs = Object.entries({ ...(p.brand ? { Производитель: bname } : {}), ...(p.series ? { Серия: p.series } : {}), ...(p.article ? { Артикул: p.article } : {}), ...(p.material ? { Материал: p.material } : {}), ...(p.specs || {}) });
---
<Base title={(p as any).title || title} description={(p as any).metaDescription || description} path={url} crumbs={crumbs} schema={schema} activeCat={topCat} image={(p as any).ogImage || v0.image} noindex={!!(p as any).noindex} canonicalUrl={(p as any).canonical}>
  <div class="wrap">
    <div class="product" data-product>
      <div>
        <div class="gallery-main">
          {v0.image ? <img id="main-img" src={u(v0.image)} alt={`${p.name}, ${v0.finish}`} width="800" height="800" fetchpriority="high" /> : <img id="main-img" src={u(NO_PHOTO)} alt="Фото товара скоро появится" width="800" height="800" />}
        </div>
        {p.variants.filter((v) => v.image).length > 1 && (
          <div class="thumbs">
            {p.variants.filter((v) => v.image).map((v, i) => <button type="button" class={i === 0 ? 'on' : ''} data-thumb={u(v.image)} aria-label={v.finish}><img src={u(v.image)} alt="" width="74" height="74" loading="lazy" /></button>)}
          </div>
        )}
      </div>
      <div>
        <div class="p-brand">{p.brand && <a href={u(`/brands/${p.brand}/`)}>{bname}</a>}{p.series && seriesUrl && <> · <a href={u(seriesUrl)}>серия {p.series}</a></>}</div>
        <h1 class="p-title">{h1}</h1>
        <div class="p-meta">{p.article && <span>Артикул: <b id="p-art">{v0.article || p.article}</b></span>}<span id="p-stock" data-yes={STOCK_LABEL.yes} data-no={STOCK_LABEL.no} style={`color:${v0.inStock === false ? 'var(--c-muted)' : 'var(--c-ok)'}`}>{v0.inStock === false ? STOCK_LABEL.no : STOCK_LABEL.yes}</span></div>
        <div class="p-price" id="p-price">{rub(v0.price)}</div>
        {SITE.priceNote && <div class="p-note">{SITE.priceNote}</div>}
        {(p.variants.length > 1 || realFinish(v0.finish)) && (
          <>
            <div style="font-size:14.5px">Покрытие: <b id="p-finish">{v0.finish}</b></div>
            <div class="finishes" role="radiogroup" aria-label="Покрытие">
              {p.variants.map((v, i) => (
                <button type="button" role="radio" aria-checked={v === v0 ? 'true' : 'false'} class={'finish' + (v === v0 ? ' on' : '')}
                  data-finish={v.finish} data-price={v.price ?? ''} data-img={v.image ? u(v.image) : ''} data-art={v.article || p.article || ''} data-stock={v.inStock === false ? '0' : '1'} data-rawimg={v.image || ''} data-cslug={colorSlug(v.finish || v.color)}>
                  <span class="sw" style={`background:${COLOR_HEX[v.color] || '#ccc'}`}></span>{v.finish || COLOR_NAMES[v.color]}
                </button>
              ))}
            </div>
          </>
        )}
        <div class="buy">
          <div class="qty"><button type="button" data-q="-1" aria-label="Меньше">−</button><input id="qty" value="1" inputmode="numeric" aria-label="Количество" /><button type="button" data-q="1" aria-label="Больше">+</button></div>
          <button class="btn btn-accent" id="add" data-add data-slug={p.slug} data-name={p.name} data-finish={v0.finish} data-price={v0.price ?? ''} data-img={v0.image ?? ''} data-url={url}>В корзину</button>
          <a class="btn btn-ghost" href={u('/catalog/komplekty-furnitury/')}>Собрать комплект</a>
        </div>
        <div class="p-perks">
          <div><Icon name="truck" />Доставка по Москве {COMPANY.delivery.mkad} ₽, бесплатно от {new Intl.NumberFormat('ru-RU').format(COMPANY.delivery.freeMoscowFrom)} ₽; в регионы транспортной компанией</div>
          <div><Icon name="shield" />Гарантия производителя, оригинальная продукция</div>
          {inShowroom(p.brand) && <div><Icon name="store" /><span>Образцы {bname} есть в <a href={u('/showroom/')}>шоуруме</a> на Флотской, наличие модели уточняйте</span></div>}
        </div>
        {(pt?.intro || p.description) && <p style="margin-top:22px;font-size:15.5px">{pt?.intro || p.description}</p>}
      </div>
    </div>

    <nav class="tabs" aria-label="Разделы карточки">{pt?.blocks?.length ? <a href="#about">Описание</a> : null}<a href="#specs">Характеристики</a>{pt?.faq?.length ? <a href="#faq">Вопросы</a> : null}{sameSeries.length > 0 && <a href="#series">Эта серия</a>}{compat.length > 0 && <a href="#compat">С этим покупают</a>}{similar.length > 0 && <a href="#similar">Похожие</a>}</nav>
    {pt?.blocks?.length ? <section id="about" class="section" style="padding-top:0"><h2>Описание модели</h2>{p.description && pt.intro && <p class="lead-block" style="margin-bottom:26px">{p.description}</p>}<Blocks blocks={pt.blocks} level={3} /></section> : null}
    <h2 id="specs-h">Характеристики</h2>
    <section id="specs" class="two-col">
      {specs.length ? <table class="specs"><tbody>{specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table> : <p style="color:var(--c-text-2)">Характеристики уточняются. Размеры, материал и совместимость с вашей дверью подскажет менеджер: {COMPANY.phoneMain}.</p>}
      <aside class="aside-box">
        <h3>Полезно</h3>
        <ul>
          {catReg && <li><a href={u(p.category)}>Все: {catReg.h1}</a></li>}
          {p.brand && <li><a href={u(`/brands/${p.brand}/`)}>Вся фурнитура {bname}</a></li>}
          {guide && <li><a href={u(`/blog/${guide.slug}/`)}>{guide.h1}</a></li>}
          <li><a href={u('/dostavka/')}>Доставка и оплата</a></li>
        </ul>
      </aside>
    </section>
    {pt?.faq?.length ? <div id="faq"><Faq items={pt.faq} title="Вопросы о модели" /></div> : null}
    {myReviews.length > 0 && <section class="section" id="reviews"><h2>Отзывы о модели</h2><p class="demo-note">{REVIEWS_NOTE}</p><div class="reviews-grid">{myReviews.map((r) => <ReviewCard r={r} />)}</div></section>}
    {sameSeries.length > 0 && <section id="series" class="section"><h2>Другие изделия серии {p.series}</h2><div class="grid">{sameSeries.map((x) => <ProductCard p={x} />)}</div></section>}
    {compat.length > 0 && <section id="compat" class="section"><h2>С этим покупают</h2><div class="grid">{compat.map((x) => <ProductCard p={x} />)}</div></section>}
    {similar.length > 0 && <section id="similar" class="section"><h2>Похожие товары</h2><div class="grid">{similar.map((x) => <ProductCard p={x} />)}</div></section>}
  </div>
</Base>
<script>
  const root = document.querySelector('[data-product]');
  const add = document.getElementById('add') as HTMLElement | null;
  const fmt = (n: string) => n ? new Intl.NumberFormat('ru-RU').format(+n) + ' ₽' : 'Цена по запросу';
  const setMain = (src: string, alt: string) => { const img = document.getElementById('main-img') as HTMLImageElement | null; if (img && src) { img.src = src; img.alt = alt; } };
  root?.querySelectorAll<HTMLButtonElement>('.finish').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('.finish').forEach((x) => { x.classList.remove('on'); x.setAttribute('aria-checked', 'false'); });
    b.classList.add('on'); b.setAttribute('aria-checked', 'true');
    const d = b.dataset;
    document.getElementById('p-price')!.textContent = fmt(d.price || '');
    document.getElementById('p-finish')!.textContent = d.finish || '';
    const art = document.getElementById('p-art'); if (art) art.textContent = d.art || '';
    const st = document.getElementById('p-stock')!; st.textContent = d.stock === '1' ? (st.dataset.yes || '') : (st.dataset.no || ''); st.style.color = d.stock === '1' ? 'var(--c-ok)' : 'var(--c-muted)';
    setMain(d.img || '', d.finish || '');
    if (add) { add.dataset.finish = d.finish; add.dataset.price = d.price; if (d.rawimg) add.dataset.img = d.rawimg; }
    if (!(b as any)._silent) { const url = new URL(location.href); url.searchParams.set('color', d.cslug || ''); history.replaceState(null, '', url); }
  }));
  // выбор покрытия из URL (?color=...)
  const want = new URLSearchParams(location.search).get('color');
  if (want) { const btn = root?.querySelector<HTMLButtonElement>(`.finish[data-cslug="${CSS.escape(want)}"]`); if (btn) { (btn as any)._silent = true; btn.click(); (btn as any)._silent = false; } }
  root?.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('[data-thumb]').forEach((x) => x.classList.remove('on')); b.classList.add('on'); setMain(b.dataset.thumb || '', '');
  }));
  root?.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) => b.addEventListener('click', () => {
    const q = document.getElementById('qty') as HTMLInputElement; q.value = String(Math.max(1, (parseInt(q.value, 10) || 1) + +(b.dataset.q || 0)));
  }));
</script>
