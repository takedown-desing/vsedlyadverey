---
import type { Product } from '../lib/data';
import { brandName, minPrice, rub, cardImage, COLOR_HEX, COLOR_NAMES, pluralRu, STOCK_LABEL } from '../lib/data';
import { u } from '../lib/url';
const { p, eager = false } = Astro.props as { p: Product; eager?: boolean };
const price = minPrice(p);
const img = cardImage(p);
const v0 = p.variants.find((v) => v.image) || p.variants[0];
const colors = [...new Set(p.variants.map((v) => v.color))];
const inStock = p.variants.some((v) => v.inStock !== false);
const href = u(`/product/${p.slug}/`);
---
<article class="card" data-card>
  <div class="card-media">
    <a href={href} class="card-img" tabindex="-1" aria-hidden="true">
      {img ? <img src={u(img)} alt="" width="400" height="400" loading={eager ? 'eager' : 'lazy'} decoding="async" /> : <svg class="noimg" viewBox="0 0 32 32" fill="none" stroke="#000" stroke-width="1"><path d="M4 10l12-6 12 6v12l-12 6-12-6z"/></svg>}
    </a>
    {p.variants.length >= 3 && <span class="badge" aria-hidden="true">{p.variants.length}<br/>{pluralRu(p.variants.length, 'цвет', 'цвета', 'цветов')}</span>}
    <div class="card-buy">
      <div class="qty qty-sm"><button type="button" data-cq="-1" aria-label="Меньше">−</button><input value="1" inputmode="numeric" aria-label="Количество" data-cqty /><button type="button" data-cq="1" aria-label="Больше">+</button></div>
      <button type="button" class="btn btn-accent btn-sm" data-add data-slug={p.slug} data-name={p.name} data-finish={v0.finish} data-price={v0.price ?? ''} data-img={v0.image ?? ''} data-url={`/product/${p.slug}/`}>В корзину</button>
    </div>
  </div>
  <div class="card-brand">{brandName(p.brand)}</div>
  <a href={href} class="card-name">{p.name}</a>
  <div class="card-sw" aria-label={'Покрытия: ' + colors.map((c) => COLOR_NAMES[c] || c).join(', ')}>
    {colors.slice(0, 7).map((c) => <span class="sw" style={`background:${COLOR_HEX[c] || '#ccc'}`} title={COLOR_NAMES[c] || c}></span>)}
  </div>
  <div class="card-price">{price ? <><small>{p.variants.length > 1 ? 'от ' : ''}</small>{rub(price)}</> : <small>Цена по запросу</small>}</div>
  <div class={'card-stock' + (inStock ? '' : ' no')}>{inStock ? STOCK_LABEL.yes : STOCK_LABEL.no}</div>
</article>
